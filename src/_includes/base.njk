<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — {{ site.title }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="/assets/css/site.css">
<script>
  (function () {
    var s = localStorage.getItem("vcc-theme");
    var t = s || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    document.documentElement.setAttribute("data-theme", t);
  })();
</script>
</head>
<body>
<header class="site-header">
  <a class="wordmark" href="/">{{ site.title }}</a>
  <nav>
    <a href="/volts/">Volts</a>
    <a href="/tools/">Calculators</a>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
      <span class="theme-toggle-label"></span>
    </button>
  </nav>
</header>
<main>{{ content | safe }}</main>
<footer class="site-footer">
  <span>© {{ site.title }}</span>
  <a href="{{ site.supportUrl }}">Support VccLabs</a>
</footer>
<p class="small-screen-notice">VccLabs is best viewed on a tablet or larger screen.</p>
<script src="/assets/js/theme.js" defer></script>
<script src="/assets/js/volt.js" defer></script>
</body>
</html>