---
pagination:
  data: voltdata
  size: 1
  alias: voltKey
permalink: "/volts/{{ voltKey }}/"
layout: null
eleventyComputed:
  title: "{{ voltdata[voltKey].title }}"
---
{% set volt = voltdata[voltKey] %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ volt.title }} — {{ site.title }}</title>
<meta name="description" content="{{ volt.blurb }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap">
<link rel="stylesheet" href="/assets/css/volt.css">
<script>
  (function () {
    var s = localStorage.getItem("vcc-theme");
    var t = s || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    document.documentElement.setAttribute("data-theme", t);
  })();
</script>
</head>
<body>

<div class="volt-shell" data-volt>
  <div class="volt-viewport">
    <div class="volt-frame" data-volt-frame>

      {% for slide in volt.slides %}
      <section class="slide{% if slide.surface == 'invert' %} invert{% endif %}"
               id="{{ slide.id }}" data-slide data-title="{{ slide.title }}">

        {% if slide.type == "cover" %}
        <div class="cover-glow"></div>
        <div class="s-head">
          <span class="cover-series">{{ slide.series }}</span>
          <span class="s-mark">Vcc<span class="ac">Labs</span></span>
        </div>
        <div class="s-body">
          <h1 class="cover-mark">{{ slide.title }}</h1>
          <p class="cover-sub">{{ slide.lead }}</p>
        </div>

        {% else %}

        <div class="s-head">
          <span class="eyebrow">{{ slide.eyebrow }}</span>
          <span class="s-mark">Vcc<span class="ac">Labs</span></span>
        </div>

        <div class="s-body">
          <h1 class="s-title"{% if slide.titleSize %} style="font-size:{{ slide.titleSize }}px"{% endif %}>{{ slide.title | safe }}</h1>
          {% if slide.lead %}<p class="s-lead">{{ slide.lead | safe }}</p>{% endif %}

          {% if slide.type == "parallel" %}
          <div class="parallel">
            {% for col in slide.columns %}
            <div class="par-col{% if col.tone == 'cost' %} is-cost{% endif %}">
              <span class="lab">{{ col.label }}</span>
              <ul>{% for item in col.items %}<li>{{ item | safe }}</li>{% endfor %}</ul>
            </div>
            {% endfor %}
          </div>
          {% endif %}

          {% if slide.type == "split" %}
          <div class="cols" style="margin-top:18px">
            <div class="col" style="flex:{{ slide.leftFlex or 1 }}">
              {% if slide.widget %}
              <div class="widget-box"><iframe title="{{ slide.widgetTitle }}" src="/widgets/{{ slide.widget }}/" loading="lazy"></iframe></div>
              {% elif slide.figure %}
              <div class="figure-box">{% include "figures/" + slide.figure + ".svg" %}</div>
              {% endif %}
            </div>
            <div class="col" style="flex:{{ slide.rightFlex or 1 }}">
              {% if slide.points %}
              <div class="points">
                {% for p in slide.points %}
                <div class="point{% if p.tone %} is-{{ p.tone }}{% endif %}">
                  <span class="n">{{ loop.index }}</span>
                  <p>{{ p.text | safe }}</p>
                </div>
                {% endfor %}
              </div>
              {% endif %}
              {% if slide.legend %}
              <dl class="legend">
                {% for row in slide.legend %}
                <div class="legend-row"><dt>{{ row.part }}</dt><dd>{{ row.role }}</dd></div>
                {% endfor %}
              </dl>
              {% endif %}
              {% if slide.callout %}<div class="callout">{{ slide.callout | safe }}</div>{% endif %}
            </div>
          </div>
          {% endif %}

          {% if slide.type == "equations" %}
          <div class="cols" style="margin-top:18px">
            {% for f in slide.formulas %}
            <div class="col">
              <span class="eq-label">{{ f.label }}</span>
              <div class="eq">{{ f.expression | safe }}</div>
              <p class="eq-note">{{ f.note }}</p>
            </div>
            {% endfor %}
          </div>
          {% if slide.points %}
          <div class="points">
            {% for p in slide.points %}
            <div class="point{% if p.tone %} is-{{ p.tone }}{% endif %}">
              <span class="n">{{ loop.index }}</span><p>{{ p.text | safe }}</p>
            </div>
            {% endfor %}
          </div>
          {% endif %}
          {% endif %}

          {% if slide.type != "split" and slide.type != "equations" and slide.callout %}
          <div class="callout">{{ slide.callout | safe }}</div>
          {% endif %}
        </div>

        <div class="s-foot">
          <span class="id">{{ slide.ref }}</span>
          <span class="rule"></span>
          <span>{{ volt.title }}</span>
        </div>

        {% endif %}

      </section>
      {% endfor %}

    </div>
  </div>
</div>

<nav class="volt-nav" data-volt-bar>
  <button type="button" data-volt-index aria-label="Slide index">Index</button>
  <span class="sep"></span>
  <button type="button" data-volt-prev aria-label="Previous slide">←</button>
  <span class="counter" data-volt-counter></span>
  <button type="button" data-volt-next aria-label="Next slide">→</button>
  <span class="sep"></span>
  <button type="button" data-theme-toggle aria-label="Toggle dark mode"><span class="theme-toggle-label"></span></button>
  <span class="sep"></span>
  <a href="/" style="padding:10px 14px;color:var(--chrome-text);font:500 13px var(--font-body);text-decoration:none">Exit</a>
</nav>

<div class="volt-index" data-volt-index-panel>
  <button class="close" type="button" data-volt-index-close>Close</button>
  <h2>{{ volt.title }}</h2>
  <ol data-volt-index-list></ol>
</div>

<script src="/assets/js/theme.js" defer></script>
<script src="/assets/js/volt.js" defer></script>
</body>
</html>
