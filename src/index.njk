<section class="how" id="how">
  <h2>How a volt works</h2>
  <div class="how-grid">
    <div class="how-item">
      <span class="n">01</span>
      <h3>A deck, not a chapter</h3>
      <p>Fifteen to twenty slides on one idea. No preamble, no worked-example padding, no chapter you have to read twice.</p>
    </div>
    <div class="how-item">
      <span class="n">02</span>
      <h3>The figures move</h3>
      <p>Drag the resonant tank and watch the gain curve answer. The interactive is the explanation, not an illustration beside it.</p>
    </div>
    <div class="how-item">
      <span class="n">03</span>
      <h3>Every number is exact</h3>
      <p>Real design values at real operating points, with the corners where the maths stops being true called out on the slide.</p>
    </div>
  </div>
</section>

<section class="volt-list">
  <h2>The library</h2>
  {% for volt in volts %}
    {% if volt.status == "published" %}
    <a class="volt-card" href="/volts/{{ volt.slug }}/">
      <span class="volt-subject">{{ volt.subject }}</span>
      <span class="volt-title">{{ volt.title }}</span>
      <span class="volt-blurb">{{ volt.blurb }}</span>
      <span class="volt-duration">{{ volt.minutes }} minute volt</span>
    </a>
    {% else %}
    <div class="volt-card is-draft">
      <span class="volt-subject">{{ volt.subject }}</span>
      <span class="volt-title">{{ volt.title }}</span>
      <span class="volt-blurb">{{ volt.blurb }}</span>
      <span class="volt-duration">In production</span>
    </div>
    {% endif %}
  {% endfor %}
</section>

